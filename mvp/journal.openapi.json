  "components": {
    "securitySchemes": {
      "patientSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "compass_session"
      },
      "doctorSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "compass_session_doctor"
      }
    },
    "schemas": {
      "JournalEntry": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "body",
          "day",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,80}$"
          },
          "type": {
            "const": "journal"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "body": {
            "type": "string",
            "maxLength": 20000
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "JournalWrite": {
        "type": "object",
        "required": [
          "id",
          "type",
          "title",
          "body",
          "day",
          "expectedRevision",
          "mutationId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,80}$"
          },
          "type": {
            "const": "journal"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "body": {
            "type": "string",
            "maxLength": 20000
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "mutationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TestResult": {
        "type": "object",
        "required": [
          "schemaVersion",
          "synthetic",
          "summary",
          "signalLevel",
          "signals"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "synthetic": {
            "const": true
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "signalLevel": {
            "enum": [
              "routine",
              "elevated",
              "urgent",
              "indeterminate"
            ]
          },
          "signals": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": [
                "category",
                "explanation",
                "sourceSpan"
              ],
              "properties": {
                "category": {
                  "const": "synthetic_fixture"
                },
                "explanation": {
                  "type": "string",
                  "maxLength": 1000
                },
                "sourceSpan": {
                  "type": "object",
                  "required": [
                    "field",
                    "start",
                    "end",
                    "quote"
                  ],
                  "properties": {
                    "field": {
                      "enum": [
                        "title",
                        "body"
                      ]
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "maxLength": 500
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Analysis": {
        "type": "object",
        "required": [
          "status",
          "revision",
          "synthetic"
        ],
        "properties": {
          "status": {
            "enum": [
              "not_requested",
              "queued",
              "running",
              "retry_wait",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "synthetic": {
            "const": true
          },
          "result": {
            "$ref": "#/components/schemas/TestResult"
          },
          "errorCode": {
            "type": "string"
          }
        }
      },
      "SavedJournal": {
        "allOf": [
          {
            "$ref": "#/components/schemas/JournalEntry"
          },
          {
            "type": "object",
            "required": [
              "currentRevision",
              "analysis"
            ],
            "properties": {
              "currentRevision": {
                "type": "integer",
                "minimum": 1
              },
              "analysis": {
                "$ref": "#/components/schemas/Analysis"
              }
            }
          }
        ]
      },
      "NoteDetail": {
        "type": "object",
        "required": [
          "entry",
          "currentRevision",
          "analysis"
        ],
        "properties": {
          "entry": {
            "$ref": "#/components/schemas/JournalEntry"
          },
          "currentRevision": {
            "type": "integer"
          },
          "analysis": {
            "$ref": "#/components/schemas/Analysis"
          },
          "patientName": {
            "type": "string"
          },
          "alert": {
            "$ref": "#/components/schemas/AlertState"
          }
        }
      },
      "AlertState": {
        "type": "object",
        "required": [
          "id",
          "state",
          "stateRevision",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "enum": [
              "new",
              "seen",
              "acknowledged"
            ]
          },
          "stateRevision": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "signal",
              "processing"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
