{
  "name": "compass-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-pdf-assets.mjs && vite build && node scripts/prepare-pwa.mjs && node scripts/compress-static.mjs && node scripts/write-build-info.mjs",
    "preview": "vite preview",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "docker:up": "node scripts/start-local.mjs",
    "docker:stop": "docker compose stop",
    "demo:share": "node scripts/share-demo.mjs",
    "demo:stop": "node scripts/share-demo.mjs --stop",
    "test:api": "node scripts/check-api.mjs",
    "test:medications": "node scripts/check-medications.mjs",
    "test:demo": "node scripts/check-demo.mjs",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "db:restore": "node scripts/restore-reference-db.mjs",
    "db:verify": "node scripts/restore-reference-db.mjs --verify",
    "db:export": "node scripts/export-reference-db.mjs",
    "journal:worker": "node scripts/run-journal-worker.mjs",
    "test:journal": "node scripts/check-journal.mjs",
    "test:appointments": "node scripts/check-appointments.mjs",
    "reference:audit": "node scripts/audit-reference-storage.mjs",
    "reference:publish": "node scripts/publish-reference-files.mjs",
    "test:integration": "node scripts/check-integration.mjs",
    "presentation:prepare": "node scripts/presentation.mjs prepare",
    "presentation:start": "node scripts/presentation.mjs start",
    "presentation:check": "node scripts/presentation.mjs check",
    "presentation:stop": "node scripts/presentation.mjs stop",
    "presentation:reset": "node scripts/presentation.mjs reset",
    "presentation:reference": "node scripts/presentation.mjs reference",
    "test:browser": "node scripts/check-integration.mjs --browser",
    "test:backup": "node scripts/check-integration.mjs --backup",
    "test:rehearsal": "node scripts/check-integration.mjs --rehearsal",
    "presentation:backup": "node scripts/presentation-backup.mjs create",
    "presentation:restore-check": "node scripts/presentation-backup.mjs check",
    "presentation:video": "node scripts/check-integration.mjs --video && node scripts/build-replay.mjs",
    "package:macos": "node scripts/build-macos-bundle.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.4"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
